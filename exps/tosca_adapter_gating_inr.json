{
  "prefix": " ",
  "dataset": "imagenetr",
  "shuffle": true,
  "memory_size": 0,
  "init_cls": 20,
  "increment": 20,
  "model_name": "tosca",
  "backbone_type": "pretrained_vit_b16_224_in21k_adapter",
  "pretrained": true,
  "device": ["0"],
  "seed": [1993],

  "mlp_ratio": 16,
  "se_ratio": 16,
